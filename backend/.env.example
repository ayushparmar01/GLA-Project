# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Allowed Frontend Origins (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Placeholder only)
MONGODB_URI=mongodb://127.0.0.1:27017/careerbridge

# Authentication Configuration (Secret key placeholder - min 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_placeholder
JWT_EXPIRES_IN=7d

# Future ICAN Sandbox Integration Settings
ICAN_SANDBOX_API_KEY=your_sandbox_api_key_placeholder
ICAN_SANDBOX_BASE_URL=https://sandbox.ican.mock/api/v1
